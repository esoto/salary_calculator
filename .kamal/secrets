# Secrets are fetched at deploy time from 1Password via the `op` CLI.
# Prereqs: `brew install --cask 1password-cli` and enable biometric unlock
# (1Password app → Settings → Developer → Integrate with 1Password CLI).
#
# 1Password item expected at "op://Personal/Salary Calculator/<field>".
# Edit the vault or item name below if yours differs.

SECRET_KEY_BASE=$(op read "op://Personal/Salary Calculator/SECRET_KEY_BASE")
POSTGRES_PASSWORD=$(op read "op://Personal/Salary Calculator/POSTGRES_PASSWORD")
DATABASE_URL="postgres://salary_calc:${POSTGRES_PASSWORD}@personal-blog-db:5432/salary_calculator_production"
KAMAL_REGISTRY_PASSWORD=$(op read "op://Personal/Salary Calculator/KAMAL_REGISTRY_PASSWORD")
RESEND_API_KEY=$(op read "op://Personal/Salary Calculator/RESEND_API_KEY")
RAILS_MASTER_KEY=$(cat config/master.key)
