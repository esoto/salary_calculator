<%= turbo_stream.replace "shares-list" do %>
  <div class="bg-navy-800 rounded-lg border border-navy-600 mt-6 p-6" id="shares-list">
    <h3 class="text-lg font-semibold text-cream font-display mb-4">Shared Links</h3>
    <div class="space-y-3" id="shares-items">
      <% @budget.budget_shares.order(created_at: :desc).each do |share| %>
        <%= render "budget_shares/share", share: share %>
      <% end %>
    </div>
  </div>
<% end %>

<%= turbo_stream.update "share-form-container" do %>
  <div class="text-center py-4">
    <p class="text-success-500 font-medium mb-2">Share link created!</p>
    <div class="flex items-center gap-2 justify-center" data-controller="clipboard">
      <input type="text" readonly value="<%= shared_budget_url(@share.token) %>"
             class="text-sm bg-navy-900 text-cream border border-navy-600 px-3 py-2 rounded w-72"
             data-clipboard-target="source" />
      <button data-action="click->clipboard#copy"
              class="text-gold-500 hover:text-gold-300 text-sm">
        Copy
      </button>
    </div>
    <button data-action="click->dialog#close"
            class="mt-4 text-warm-gray hover:text-cream">
      Done
    </button>
  </div>
<% end %>
