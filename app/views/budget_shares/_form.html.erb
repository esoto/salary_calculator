<%= form_with model: share, url: budget_budget_shares_path(budget), id: "share_form", data: { turbo_frame: "_top" } do |f| %>
  <div class="space-y-4">
    <div>
      <%= f.label :name, "Name (optional)", class: "block text-sm font-medium text-warm-gray" %>
      <%= f.text_field :name, placeholder: "e.g., For accountant",
          class: "mt-1 block w-full bg-navy-900 text-cream rounded-md border border-navy-600 px-3 py-2 focus:border-gold-500 focus:ring-1 focus:ring-gold-500" %>
    </div>

    <fieldset>
      <legend class="text-sm font-medium text-warm-gray mb-2">Include in shared view:</legend>
      <div class="space-y-2">
        <label class="flex items-center">
          <%= f.check_box :show_budget, class: "rounded border-navy-600 text-gold-500 focus:ring-gold-500" %>
          <span class="ml-2 text-sm text-cream">Budget details (categories & items)</span>
        </label>
        <label class="flex items-center">
          <%= f.check_box :show_income_sources, class: "rounded border-navy-600 text-gold-500 focus:ring-gold-500" %>
          <span class="ml-2 text-sm text-cream">Income sources</span>
        </label>
        <label class="flex items-center">
          <%= f.check_box :show_personal_savings, class: "rounded border-navy-600 text-gold-500 focus:ring-gold-500" %>
          <span class="ml-2 text-sm text-cream">Personal savings</span>
        </label>
      </div>
    </fieldset>

    <div>
      <%= f.label :expires_at, "Expires (optional)", class: "block text-sm font-medium text-warm-gray" %>
      <%= f.date_field :expires_at,
          class: "mt-1 block w-full bg-navy-900 text-cream rounded-md border border-navy-600 px-3 py-2 focus:border-gold-500 focus:ring-1 focus:ring-gold-500" %>
      <p class="mt-1 text-xs text-muted-light">Leave blank for no expiration</p>
    </div>

    <div class="flex justify-end gap-3 pt-4">
      <button type="button" data-action="click->dialog#close"
              class="px-4 py-2 text-warm-gray hover:text-cream">
        Cancel
      </button>
      <%= f.submit "Create Share Link",
          class: "bg-gold-btn text-navy-900 font-semibold px-4 py-2 rounded-lg cursor-pointer" %>
    </div>
  </div>
<% end %>
