<!DOCTYPE html>
<html>
  <head>
    <title>Salary Calculator</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,600;6..72,700&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-navy-950 min-h-screen font-body text-cream">
    <nav class="bg-navy-900 border-b border-navy-600">
      <div class="max-w-6xl mx-auto px-4 py-4">
        <div class="flex justify-between items-center">
          <%= link_to "Salary Calculator", dashboard_path, class: "text-xl font-bold text-cream font-display" %>

          <div class="flex items-center gap-4">
            <% if authenticated? %>
              <%= link_to "Entries", salary_entries_path, class: nav_link_class(salary_entries_path) %>
              <%= link_to "Budgets", budgets_path, class: nav_link_class(budgets_path) %>
              <% if Current.user.household.present? %>
                <%= link_to "Household", household_path, class: nav_link_class(household_path) %>
              <% end %>
              <%= link_to Current.user.name, settings_path, class: nav_link_class(settings_path) %>
              <%= button_to "Log out", session_path, method: :delete,
                  class: "text-warm-gray hover:text-gold-300 text-sm" %>
            <% else %>
              <%= link_to "Log in", new_session_path, class: "text-warm-gray hover:text-gold-500" %>
              <%= link_to "Sign up", new_registration_path,
                  class: "bg-gold-btn text-navy-900 px-4 py-2 rounded-lg font-semibold hover:shadow-lg hover:shadow-amber-900/20" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="max-w-6xl mx-auto px-4 mt-4" data-controller="flash">
        <div class="bg-success-600/10 border border-success-500/30 text-success-500 rounded-lg p-4 flex justify-between items-center">
          <span><%= notice %></span>
          <button data-action="click->flash#dismiss" class="text-success-500 hover:text-success-600 ml-4">&times;</button>
        </div>
      </div>
    <% end %>

    <% if alert %>
      <div class="max-w-6xl mx-auto px-4 mt-4" data-controller="flash">
        <div class="bg-error-600/10 border border-error-500/30 text-error-500 rounded-lg p-4 flex justify-between items-center">
          <span><%= alert %></span>
          <button data-action="click->flash#dismiss" class="text-error-500 hover:text-error-600 ml-4">&times;</button>
        </div>
      </div>
    <% end %>

    <main class="py-8">
      <%= yield %>
    </main>
  </body>
</html>
