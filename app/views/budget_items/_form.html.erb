<%= form_with model: [budget, budget_item],
              url: budget_item.persisted? ? budget_budget_item_path(budget, budget_item) : budget_budget_items_path(budget),
              id: budget_item_form_id(budget_item, category),
              namespace: category,
              class: "flex flex-col gap-2" do |f| %>
  <% if budget_item.errors.any? %>
    <div class="text-red-600 text-xs">
      <%= budget_item.errors.full_messages.first %>
    </div>
  <% end %>

  <%= f.hidden_field :category, value: category %>

  <div class="flex gap-2">
    <%= f.text_field :name,
        placeholder: "Item name",
        required: true,
        class: "flex-1 border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div class="flex gap-2">
    <%= f.number_field :amount,
        placeholder: "Amount",
        step: 0.01,
        min: 0,
        required: true,
        class: "w-24 border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500" %>

    <%= f.select :currency,
        options_for_select([["USD", "usd"], ["CRC", "crc"]], budget_item.currency || "usd"),
        {},
        class: "border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500" %>

    <%= f.submit budget_item.persisted? ? "Update" : "+ Add",
        class: "bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-sm cursor-pointer" %>
  </div>
<% end %>
