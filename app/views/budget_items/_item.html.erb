<div class="p-3 hover:bg-gray-50 group" id="<%= dom_id(item) %>">
  <div class="flex items-center gap-2">
    <!-- Paid checkbox -->
    <%= form_with url: toggle_paid_budget_budget_item_path(item.monthly_budget, item),
                  method: :patch,
                  data: { turbo_frame: dom_id(item) },
                  class: "inline" do %>
      <button type="submit" class="text-lg leading-none">
        <% if item.paid %>
          <span class="text-green-600">☑</span>
        <% else %>
          <span class="text-gray-400 hover:text-gray-600">☐</span>
        <% end %>
      </button>
    <% end %>

    <!-- Item name -->
    <span class="flex-1 text-sm <%= item.paid ? 'text-gray-400 line-through' : 'text-gray-800' %>">
      <%= item.name %>
    </span>

    <!-- Amount -->
    <span class="text-sm font-medium <%= item.paid ? 'text-gray-400' : 'text-gray-800' %>">
      <% if item.currency == "USD" %>
        <%= format_usd(item.amount) %>
      <% else %>
        <%= format_crc(item.amount) %>
      <% end %>
    </span>

    <!-- Delete button (visible on hover) -->
    <%= button_to budget_budget_item_path(item.monthly_budget, item),
        method: :delete,
        data: { turbo_confirm: "Delete this item?" },
        class: "opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 text-sm transition-opacity" do %>
      ✕
    <% end %>
  </div>

  <!-- Converted amount (secondary) -->
  <div class="ml-6 text-xs text-gray-400">
    <% if item.currency == "USD" %>
      ≈ <%= format_crc(item.amount_in_crc) %>
    <% else %>
      ≈ <%= format_usd(item.amount_in_usd) %>
    <% end %>
  </div>
</div>
