<div class="p-3 hover:bg-gray-50 group" id="<%= dom_id(item) %>"
     data-controller="inline-edit"
     data-inline-edit-editing-class="hidden">
  <!-- Display mode -->
  <div class="flex items-center gap-2" data-inline-edit-target="display">
    <!-- Paid checkbox -->
    <%= form_with url: toggle_paid_budget_budget_item_path(item.monthly_budget, item),
                  method: :patch,
                  class: "inline" do %>
      <button type="submit"
              class="text-lg leading-none"
              aria-label="<%= item.paid ? 'Mark as unpaid' : 'Mark as paid' %>">
        <% if item.paid %>
          <span class="text-green-600" aria-hidden="true">☑</span>
        <% else %>
          <span class="text-gray-400 hover:text-gray-600" aria-hidden="true">☐</span>
        <% end %>
      </button>
    <% end %>

    <!-- Item name (clickable to edit) -->
    <button type="button"
            data-action="click->inline-edit#edit"
            class="flex-1 text-left text-sm <%= item.paid ? 'text-gray-400 line-through' : 'text-gray-800 hover:text-blue-600' %>">
      <%= item.name %>
    </button>

    <!-- Amount -->
    <span class="text-sm font-medium <%= item.paid ? 'text-gray-400' : 'text-gray-800' %>">
      <% if item.usd? %>
        <%= format_usd(item.amount) %>
      <% else %>
        <%= format_crc(item.amount) %>
      <% end %>
    </span>

    <!-- Edit button (visible on hover) -->
    <button type="button"
            data-action="click->inline-edit#edit"
            aria-label="Edit <%= item.name %>"
            class="opacity-0 group-hover:opacity-100 text-blue-500 hover:text-blue-700 text-sm transition-opacity">
      <span aria-hidden="true">✎</span>
    </button>

    <!-- Delete button (visible on hover) -->
    <%= button_to budget_budget_item_path(item.monthly_budget, item),
        method: :delete,
        data: { turbo_confirm: "Delete this item?" },
        aria: { label: "Delete #{item.name}" },
        class: "opacity-0 group-hover:opacity-100 text-red-500 hover:text-red-700 text-sm transition-opacity" do %>
      <span aria-hidden="true">✕</span>
    <% end %>
  </div>

  <!-- Edit mode -->
  <div class="hidden" data-inline-edit-target="form">
    <%= form_with model: [item.monthly_budget, item],
                  url: budget_budget_item_path(item.monthly_budget, item),
                  class: "flex flex-col gap-2" do |f| %>
      <div class="flex gap-2">
        <%= f.text_field :name,
            required: true,
            class: "flex-1 border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500" %>
      </div>
      <div class="flex gap-2">
        <%= f.number_field :amount,
            step: 0.01,
            min: 0,
            required: true,
            class: "w-24 border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500" %>
        <%= f.select :currency,
            options_for_select([["USD", "usd"], ["CRC", "crc"]], item.currency),
            {},
            class: "border border-gray-300 rounded px-2 py-1 text-sm focus:outline-none focus:ring-1 focus:ring-blue-500" %>
        <%= f.submit "Save",
            class: "bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-sm cursor-pointer" %>
        <button type="button"
                data-action="click->inline-edit#cancel"
                class="text-gray-500 hover:text-gray-700 px-2 py-1 text-sm">
          Cancel
        </button>
      </div>
    <% end %>
  </div>

  <!-- Converted amount (secondary) -->
  <div class="ml-6 text-xs text-gray-400">
    <% if item.usd? %>
      ≈ <%= format_crc(item.amount_in_crc) %>
    <% else %>
      ≈ <%= format_usd(item.amount_in_usd) %>
    <% end %>
  </div>
</div>
