<% items = budget.budget_items.select { |i| i.category == category }.sort_by { |i| [i.position || 999, i.created_at] } %>

<div class="bg-navy-800 rounded-lg border border-navy-600">
  <div class="p-4 border-b border-navy-600">
    <div class="flex justify-between items-start">
      <div>
        <h3 class="font-semibold text-cream"><%= category_display_name(category) %></h3>
        <p class="text-xs text-warm-gray">Target: <%= category_target_range(category) %></p>
      </div>
      <div class="text-right">
        <% status = budget.category_status(category) %>
        <span class="text-sm font-medium <%= category_status_color(status) %>">
          <%= category_status_icon(status) %> <%= budget.category_percentage(category) %>%
        </span>
        <p class="text-sm font-medium text-cream"><%= format_usd(budget.category_total_usd(category)) %></p>
      </div>
    </div>
  </div>

  <div class="p-4">
    <% items.each do |item| %>
      <div class="flex justify-between items-center py-2 border-b border-navy-600 last:border-0">
        <span class="text-sm <%= item.paid? ? 'text-muted-light line-through' : 'text-cream' %>">
          <%= item.name %>
        </span>
        <span class="text-sm font-medium text-cream">
          <%= item.usd? ? format_usd(item.amount) : format_crc(item.amount) %>
        </span>
      </div>
    <% end %>

    <% if items.empty? %>
      <p class="text-sm text-muted-light text-center py-2">No items</p>
    <% end %>
  </div>
</div>
