<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to entries", salary_entries_path(year: @year), class: "text-gold-500 hover:text-gold-300" %>
  </div>

  <h1 class="text-3xl font-bold text-cream font-display mb-6">Yearly Summary</h1>

  <div class="mb-6">
    <%= form_tag summary_salary_entries_path, method: :get, class: "flex items-center gap-4" do %>
      <label for="year" class="font-medium text-cream">Year:</label>
      <%= select_tag :year, options_for_select(@available_years, @year),
          class: "border border-navy-600 rounded-lg px-3 py-2 bg-navy-900 text-cream",
          onchange: "this.form.submit()" %>
    <% end %>
  </div>

  <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
    <div class="grid grid-cols-2 gap-6 mb-8">
      <div class="bg-navy-900 rounded-lg p-4">
        <p class="text-sm text-warm-gray">Entries Recorded</p>
        <p class="text-3xl font-bold text-cream"><%= @summary[:entries_count] %> / 12</p>
      </div>
      <div class="bg-gold-500/10 rounded-lg p-4">
        <p class="text-sm text-gold-500">Total Earnings</p>
        <p class="text-3xl font-bold text-gold-300"><%= format_currency(@summary[:total_earnings]) %></p>
      </div>
    </div>

    <h2 class="text-lg font-semibold text-cream font-display mb-4">Total Savings for <%= @year %></h2>

    <div class="space-y-4">
      <% if current_user.aguinaldo_enabled %>
      <div class="flex justify-between items-center p-4 bg-success-600/10 rounded-lg">
        <span class="text-cream">Aguinaldo (13th month)</span>
        <span class="text-xl font-semibold text-success-500"><%= format_currency(@summary[:total_aguinaldo]) %></span>
      </div>
      <% end %>
      <% if current_user.vacation_enabled %>
      <div class="flex justify-between items-center p-4 bg-success-600/10 rounded-lg">
        <span class="text-cream">Vacation (<%= current_user.vacation_days_per_year %> days)</span>
        <span class="text-xl font-semibold text-success-500"><%= format_currency(@summary[:total_vacation]) %></span>
      </div>
      <% end %>
      <% if current_user.holiday_enabled %>
      <div class="flex justify-between items-center p-4 bg-success-600/10 rounded-lg">
        <span class="text-cream">Holidays (<%= current_user.holiday_days_per_year %> days)</span>
        <span class="text-xl font-semibold text-success-500"><%= format_currency(@summary[:total_holidays]) %></span>
      </div>
      <% end %>
      <div class="flex justify-between items-center p-6 bg-success-600/20 rounded-lg border-2 border-success-500/30">
        <span class="text-lg font-semibold text-cream">Total Savings</span>
        <span class="text-3xl font-bold text-success-500"><%= format_currency(@summary[:total_savings]) %></span>
      </div>
    </div>
  </div>
</div>
