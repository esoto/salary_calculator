<%= form_with model: salary_entry, class: "space-y-6" do |form| %>
  <% if salary_entry.errors.any? %>
    <div class="bg-error-600/10 border border-error-500/30 rounded-lg p-4">
      <h2 class="text-error-500 font-medium mb-2"><%= pluralize(salary_entry.errors.count, "error") %> prevented saving:</h2>
      <ul class="list-disc list-inside text-error-500 text-sm">
        <% salary_entry.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= form.label :month, class: "block text-sm font-medium text-cream mb-1" %>
      <%= form.select :month, (1..12).map { |m| [Date::MONTHNAMES[m], m] },
          {}, class: "w-full border border-navy-600 rounded-lg px-3 py-2 bg-navy-900 text-cream focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
    </div>

    <div>
      <%= form.label :year, class: "block text-sm font-medium text-cream mb-1" %>
      <%= form.number_field :year, min: 2020, max: 2100,
          class: "w-full border border-navy-600 rounded-lg px-3 py-2 bg-navy-900 text-cream focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-6">
    <div>
      <%= form.label :hours_worked, class: "block text-sm font-medium text-cream mb-1" %>
      <%= form.number_field :hours_worked, step: 0.01, min: 0,
          class: "w-full border border-navy-600 rounded-lg px-3 py-2 bg-navy-900 text-cream focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
    </div>

    <div>
      <%= form.label :hourly_rate, class: "block text-sm font-medium text-cream mb-1" %>
      <%= form.number_field :hourly_rate, step: 0.01, min: 0,
          class: "w-full border border-navy-600 rounded-lg px-3 py-2 bg-navy-900 text-cream focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <% if current_user.vacation_enabled %>
      <div>
        <%= form.label :vacation_days_taken, "Vacation days taken", class: "block text-sm font-medium text-cream mb-1" %>
        <%= form.number_field :vacation_days_taken, step: 0.5, min: 0,
            class: "w-full border border-navy-600 rounded-lg px-3 py-2 bg-navy-900 text-cream focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
      </div>
    <% end %>
    <% if current_user.holiday_enabled %>
      <div>
        <%= form.label :holiday_days_taken, "Holiday days taken", class: "block text-sm font-medium text-cream mb-1" %>
        <%= form.number_field :holiday_days_taken, step: 0.5, min: 0,
            class: "w-full border border-navy-600 rounded-lg px-3 py-2 bg-navy-900 text-cream focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
      </div>
    <% end %>
  </div>

  <% if @over_vacation_limit %>
    <div class="bg-amber-900/20 border border-amber-700/50 rounded-lg p-4">
      <p class="text-amber-200 font-medium">Vacation days warning</p>
      <p class="text-amber-100 text-sm mt-1">
        You're taking <%= number_with_precision(@vacation_over_by, precision: 1, strip_insignificant_zeros: true) %>
        more days than earned. This means you'll need to use money from holiday
        and/or aguinaldo savings, affecting future finances.
      </p>
      <label class="flex items-center mt-3">
        <%= form.check_box :vacation_over_limit_acknowledged,
            class: "h-4 w-4 text-amber-600 rounded border-navy-600",
            checked: salary_entry.vacation_over_limit_acknowledged.present? %>
        <span class="ml-2 text-sm text-amber-200">I understand this affects my savings</span>
      </label>
    </div>
  <% end %>

  <div class="flex gap-4">
    <%= form.submit class: "bg-gold-btn text-navy-900 font-semibold hover:shadow-lg hover:shadow-amber-900/20 px-6 py-2 rounded-lg cursor-pointer" %>
    <%= link_to "Cancel", salary_entries_path, class: "border border-navy-600 hover:bg-navy-900 text-warm-gray px-6 py-2 rounded-lg" %>
  </div>
<% end %>
