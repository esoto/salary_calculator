<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-cream font-display">Salary Entries</h1>
    <div class="flex gap-4">
      <%= link_to "View Summary", summary_salary_entries_path(year: @year),
          class: "bg-navy-600 hover:bg-navy-800 text-cream px-4 py-2 rounded-lg" %>
      <%= link_to "New Entry", new_salary_entry_path,
          class: "bg-gold-btn text-navy-900 font-semibold hover:shadow-lg hover:shadow-amber-900/20 px-4 py-2 rounded-lg" %>
    </div>
  </div>

  <div class="mb-6">
    <%= form_tag salary_entries_path, method: :get, class: "flex items-center gap-4" do %>
      <label for="year" class="font-medium text-cream">Year:</label>
      <%= select_tag :year, options_for_select(@available_years, @year),
          class: "border border-navy-600 rounded-lg px-3 py-2 bg-navy-900 text-cream",
          onchange: "this.form.submit()" %>
    <% end %>
  </div>

  <% if @salary_entries.any? %>
    <div class="overflow-x-auto bg-navy-800 rounded-lg border border-navy-600">
      <table class="min-w-full divide-y divide-navy-600">
        <thead class="bg-navy-900">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-muted-light uppercase">Month</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Hours</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Rate</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Salary</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Savings</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Net Pay</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-navy-800 divide-y divide-navy-600">
          <% @salary_entries.each do |entry| %>
            <tr class="hover:bg-navy-900/50">
              <td class="px-6 py-4 whitespace-nowrap">
                <%= link_to month_name(entry.month), entry, class: "text-gold-500 hover:text-gold-300" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-cream"><%= format_hours(entry.hours_worked) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-cream"><%= format_currency(entry.hourly_rate) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right font-medium text-cream"><%= format_currency(entry.monthly_salary) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-success-500"><%= format_currency(entry.total_savings) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right font-bold text-gold-500"><%= format_currency(entry.net_pay) %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <%= link_to "Edit", edit_salary_entry_path(entry), class: "text-warm-gray hover:text-cream mr-3" %>
                <%= link_to "Delete", entry, method: :delete, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                    class: "text-error-500 hover:text-error-500" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 bg-navy-800 rounded-lg border border-navy-600">
      <p class="text-warm-gray mb-4">No salary entries for <%= @year %>.</p>
      <%= link_to "Create your first entry", new_salary_entry_path, class: "text-gold-500 hover:text-gold-300" %>
    </div>
  <% end %>
</div>
