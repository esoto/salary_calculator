<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to entries", salary_entries_path(year: @salary_entry.year), class: "text-gold-500 hover:text-gold-300" %>
  </div>

  <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
    <h1 class="text-3xl font-bold text-cream font-display mb-6">
      <%= month_name(@salary_entry.month) %> <%= @salary_entry.year %>
    </h1>

    <div class="grid grid-cols-2 gap-6 mb-8">
      <div>
        <p class="text-sm text-warm-gray">Hours Worked</p>
        <p class="text-2xl font-semibold text-cream"><%= format_hours(@salary_entry.hours_worked) %></p>
      </div>
      <div>
        <p class="text-sm text-warm-gray">Hourly Rate</p>
        <p class="text-2xl font-semibold text-cream"><%= format_currency(@salary_entry.hourly_rate) %></p>
      </div>
    </div>

    <div class="border-t border-navy-600 pt-6 mb-8">
      <p class="text-sm text-warm-gray mb-2">Monthly Salary</p>
      <p class="text-4xl font-bold text-cream"><%= format_currency(@salary_entry.monthly_salary) %></p>
      <% has_time_off_pay = @salary_entry.vacation_spent > 0 || @salary_entry.holiday_spent > 0 %>
      <% if has_time_off_pay || @salary_entry.bank_fee > 0 %>
        <div class="mt-3 text-sm text-warm-gray space-y-1">
          <% if has_time_off_pay %>
            <div class="flex justify-between">
              <span>Base salary (<%= format_hours(@salary_entry.hours_worked) %> × <%= format_currency(@salary_entry.hourly_rate) %>)</span>
              <span><%= format_currency(@salary_entry.base_salary) %></span>
            </div>
            <% if @salary_entry.vacation_spent > 0 %>
              <div class="flex justify-between text-success-500">
                <span>+ Vacation pay (<%= @salary_entry.vacation_days_taken %> days)</span>
                <span>+<%= format_currency(@salary_entry.vacation_spent) %></span>
              </div>
            <% end %>
            <% if @salary_entry.holiday_spent > 0 %>
              <div class="flex justify-between text-success-500">
                <span>+ Holiday pay (<%= @salary_entry.holiday_days_taken %> days)</span>
                <span>+<%= format_currency(@salary_entry.holiday_spent) %></span>
              </div>
            <% end %>
            <div class="flex justify-between font-medium border-t border-navy-600 pt-1 mt-1 text-cream">
              <span>Gross salary</span>
              <span><%= format_currency(@salary_entry.gross_salary) %></span>
            </div>
          <% elsif @salary_entry.bank_fee > 0 %>
            <div class="flex justify-between text-cream">
              <span>Gross salary</span>
              <span><%= format_currency(@salary_entry.gross_salary) %></span>
            </div>
          <% end %>
          <% if @salary_entry.bank_fee > 0 %>
            <div class="flex justify-between text-error-500">
              <span>- Bank transfer fee</span>
              <span>-<%= format_currency(@salary_entry.bank_fee) %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <% if current_user.any_savings_enabled? %>
    <div class="border-t border-navy-600 pt-6">
      <h2 class="text-lg font-semibold text-cream font-display mb-4">Savings Breakdown</h2>
      <div class="space-y-4">
        <% if current_user.aguinaldo_enabled %>
        <div class="flex justify-between">
          <span class="text-warm-gray">Aguinaldo (13th month)</span>
          <span class="font-medium text-success-500"><%= format_currency(@salary_entry.aguinaldo_savings) %></span>
        </div>
        <% end %>
        <% if current_user.vacation_enabled %>
        <div class="flex justify-between">
          <span class="text-warm-gray">Vacation (<%= current_user.vacation_days_per_year %> days)</span>
          <span class="font-medium text-success-500"><%= format_currency(@salary_entry.vacation_savings) %></span>
        </div>
        <% end %>
        <% if current_user.holiday_enabled %>
        <div class="flex justify-between">
          <span class="text-warm-gray">Holidays (<%= current_user.holiday_days_per_year %> days)</span>
          <span class="font-medium text-success-500"><%= format_currency(@salary_entry.holiday_savings) %></span>
        </div>
        <% end %>
        <div class="flex justify-between border-t border-navy-600 pt-4">
          <span class="font-semibold text-cream">Total Savings</span>
          <span class="font-bold text-success-500 text-xl"><%= format_currency(@salary_entry.monthly_savings_accrual) %></span>
        </div>
      </div>
    </div>
    <% end %>

    <% if @salary_entry.vacation_days_taken > 0 || @salary_entry.holiday_days_taken > 0 %>
      <div class="border-t border-navy-600 pt-6 mt-6">
        <h2 class="text-lg font-semibold text-cream font-display mb-4">Time Off Taken</h2>
        <div class="space-y-3">
          <% if @salary_entry.vacation_days_taken > 0 %>
            <div class="flex justify-between">
              <span class="text-warm-gray">Vacation (<%= @salary_entry.vacation_days_taken %> days)</span>
              <span class="font-medium text-error-500">-<%= format_currency(@salary_entry.vacation_spent) %></span>
            </div>
          <% end %>
          <% if @salary_entry.holiday_days_taken > 0 %>
            <div class="flex justify-between">
              <span class="text-warm-gray">Holidays (<%= @salary_entry.holiday_days_taken %> days)</span>
              <span class="font-medium text-error-500">-<%= format_currency(@salary_entry.holiday_spent) %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="border-t border-navy-600 pt-6 mt-6">
      <p class="text-sm text-warm-gray mb-2">Net Pay (Gross Salary<%= " - Bank Fee" if @salary_entry.bank_fee > 0 %> - Savings)</p>
      <p class="text-4xl font-bold text-gold-500"><%= format_currency(@salary_entry.net_pay) %></p>
      <div class="mt-2 text-sm text-warm-gray">
        <span><%= format_currency(@salary_entry.gross_salary) %><%= " - #{format_currency(@salary_entry.bank_fee)}" if @salary_entry.bank_fee > 0 %> - <%= format_currency(@salary_entry.monthly_savings_deduction) %></span>
      </div>
    </div>

    <div class="mt-8 flex gap-4">
      <%= link_to "Edit", edit_salary_entry_path(@salary_entry),
          class: "bg-gold-btn text-navy-900 font-semibold hover:shadow-lg hover:shadow-amber-900/20 px-4 py-2 rounded-lg" %>
      <%= link_to "Delete", @salary_entry, method: :delete,
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
          class: "bg-error-500/20 hover:bg-error-500/30 text-error-500 px-4 py-2 rounded-lg" %>
    </div>
  </div>
</div>
