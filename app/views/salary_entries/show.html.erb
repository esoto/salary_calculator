<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to entries", salary_entries_path(year: @salary_entry.year), class: "text-blue-600 hover:text-blue-800" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">
      <%= month_name(@salary_entry.month) %> <%= @salary_entry.year %>
    </h1>

    <div class="grid grid-cols-2 gap-6 mb-8">
      <div>
        <p class="text-sm text-gray-500">Hours Worked</p>
        <p class="text-2xl font-semibold"><%= format_hours(@salary_entry.hours_worked) %></p>
      </div>
      <div>
        <p class="text-sm text-gray-500">Hourly Rate</p>
        <p class="text-2xl font-semibold"><%= format_currency(@salary_entry.hourly_rate) %></p>
      </div>
    </div>

    <div class="border-t pt-6 mb-8">
      <p class="text-sm text-gray-500 mb-2">Monthly Salary</p>
      <p class="text-4xl font-bold text-gray-900"><%= format_currency(@salary_entry.monthly_salary) %></p>
      <% has_time_off_pay = @salary_entry.vacation_spent > 0 || @salary_entry.holiday_spent > 0 %>
      <% if has_time_off_pay || @salary_entry.bank_fee > 0 %>
        <div class="mt-3 text-sm text-gray-500 space-y-1">
          <% if has_time_off_pay %>
            <div class="flex justify-between">
              <span>Base salary (<%= format_hours(@salary_entry.hours_worked) %> × <%= format_currency(@salary_entry.hourly_rate) %>)</span>
              <span><%= format_currency(@salary_entry.base_salary) %></span>
            </div>
            <% if @salary_entry.vacation_spent > 0 %>
              <div class="flex justify-between text-green-600">
                <span>+ Vacation pay (<%= @salary_entry.vacation_days_taken %> days)</span>
                <span>+<%= format_currency(@salary_entry.vacation_spent) %></span>
              </div>
            <% end %>
            <% if @salary_entry.holiday_spent > 0 %>
              <div class="flex justify-between text-green-600">
                <span>+ Holiday pay (<%= @salary_entry.holiday_days_taken %> days)</span>
                <span>+<%= format_currency(@salary_entry.holiday_spent) %></span>
              </div>
            <% end %>
            <div class="flex justify-between font-medium border-t border-gray-200 pt-1 mt-1">
              <span>Gross salary</span>
              <span><%= format_currency(@salary_entry.gross_salary) %></span>
            </div>
          <% elsif @salary_entry.bank_fee > 0 %>
            <div class="flex justify-between">
              <span>Gross salary</span>
              <span><%= format_currency(@salary_entry.gross_salary) %></span>
            </div>
          <% end %>
          <% if @salary_entry.bank_fee > 0 %>
            <div class="flex justify-between text-red-600">
              <span>- Bank transfer fee</span>
              <span>-<%= format_currency(@salary_entry.bank_fee) %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="border-t pt-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Savings Breakdown</h2>
      <div class="space-y-4">
        <div class="flex justify-between">
          <span class="text-gray-600">Aguinaldo (13th month)</span>
          <span class="font-medium text-green-600"><%= format_currency(@salary_entry.aguinaldo_savings) %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Vacation (18 days)</span>
          <span class="font-medium text-green-600"><%= format_currency(@salary_entry.vacation_savings) %></span>
        </div>
        <div class="flex justify-between">
          <span class="text-gray-600">Holidays (10 days)</span>
          <span class="font-medium text-green-600"><%= format_currency(@salary_entry.holiday_savings) %></span>
        </div>
        <div class="flex justify-between border-t pt-4">
          <span class="font-semibold text-gray-900">Total Savings</span>
          <span class="font-bold text-green-700 text-xl"><%= format_currency(@salary_entry.monthly_savings_accrual) %></span>
        </div>
      </div>
    </div>

    <% if @salary_entry.vacation_days_taken > 0 || @salary_entry.holiday_days_taken > 0 %>
      <div class="border-t pt-6 mt-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Time Off Taken</h2>
        <div class="space-y-3">
          <% if @salary_entry.vacation_days_taken > 0 %>
            <div class="flex justify-between">
              <span class="text-gray-600">Vacation (<%= @salary_entry.vacation_days_taken %> days)</span>
              <span class="font-medium text-red-600">-<%= format_currency(@salary_entry.vacation_spent) %></span>
            </div>
          <% end %>
          <% if @salary_entry.holiday_days_taken > 0 %>
            <div class="flex justify-between">
              <span class="text-gray-600">Holidays (<%= @salary_entry.holiday_days_taken %> days)</span>
              <span class="font-medium text-red-600">-<%= format_currency(@salary_entry.holiday_spent) %></span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="border-t pt-6 mt-6">
      <p class="text-sm text-gray-500 mb-2">Net Pay (Monthly Salary - Savings)</p>
      <p class="text-4xl font-bold text-blue-600"><%= format_currency(@salary_entry.net_pay) %></p>
      <div class="mt-2 text-sm text-gray-500">
        <span><%= format_currency(@salary_entry.monthly_salary) %> - <%= format_currency(@salary_entry.monthly_savings_deduction) %></span>
      </div>
    </div>

    <div class="mt-8 flex gap-4">
      <%= link_to "Edit", edit_salary_entry_path(@salary_entry),
          class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg" %>
      <%= link_to "Delete", @salary_entry, method: :delete,
          data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
          class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg" %>
    </div>
  </div>
</div>
