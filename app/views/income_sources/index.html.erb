<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Income Sources</h1>
    <%= link_to "Back to Budgets", budgets_path, class: "text-gray-600 hover:text-gray-800" %>
  </div>

  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Add Income Source</h2>
    <%= form_with model: @new_income_source, url: income_sources_path, class: "grid grid-cols-1 md:grid-cols-2 gap-4" do |f| %>
      <% if @new_income_source.errors.any? %>
        <div class="md:col-span-2 bg-red-50 border border-red-200 rounded-lg p-4">
          <ul class="list-disc list-inside text-red-700">
            <% @new_income_source.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= f.label :income_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :income_type, IncomeSource.income_types.keys.map { |t| [t.humanize, t] }, {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= f.label :amount, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.number_field :amount, step: 0.01, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= f.label :currency, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :currency, IncomeSource.currencies.keys.map { |c| [c.upcase, c] }, {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= f.label :linked_user_id, "Link to User (for hourly)", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= f.select :linked_user_id, @linkable_users.map { |u| [u.name, u.id] }, { include_blank: "None" }, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
      </div>

      <div class="flex items-end">
        <%= f.submit "Add Income Source", class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <% if @income_sources.any? %>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Currency</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @income_sources.each do |source| %>
            <tr class="hover:bg-gray-50">
              <td class="px-6 py-4 whitespace-nowrap font-medium"><%= source.name %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= source.income_type.humanize %></td>
              <td class="px-6 py-4 whitespace-nowrap text-right"><%= source.amount ? number_with_precision(source.amount, precision: 2) : "-" %></td>
              <td class="px-6 py-4 whitespace-nowrap"><%= source.currency.upcase %></td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if source.active? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">Inactive</span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <%= link_to "Delete", income_source_path(source), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "text-red-600 hover:text-red-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 bg-white rounded-lg shadow">
      <p class="text-gray-500">No income sources yet. Add one above to get started.</p>
    </div>
  <% end %>
</div>
