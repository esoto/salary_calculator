<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold text-cream font-display">Income Sources</h1>
      <p class="text-warm-gray">Manage your income for budget calculations</p>
    </div>
    <%= link_to "← Back to Budgets", budgets_path, class: "text-gold-500 hover:text-gold-300" %>
  </div>

  <div class="bg-navy-800 rounded-lg border border-navy-600 p-6 mb-6">
    <h2 class="text-xl font-semibold text-cream font-display mb-4">Add Income Source</h2>
    <%= form_with model: @new_income_source, url: income_sources_path, class: "space-y-4", data: { controller: "income-source" } do |f| %>
      <% if @new_income_source.errors.any? %>
        <div class="bg-error-600/10 border border-error-500/30 rounded-lg p-4">
          <ul class="list-disc list-inside text-error-500">
            <% @new_income_source.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= f.label :name, class: "block text-sm font-medium text-warm-gray mb-1" %>
          <%= f.text_field :name, required: true,
              class: "w-full bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
        </div>

        <% if @linkable_users.size > 1 %>
          <div>
            <%= f.label :user_id, "Owner", class: "block text-sm font-medium text-warm-gray mb-1" %>
            <%= f.select :user_id,
                @linkable_users.map { |u| [u.name + (u == current_user ? " (me)" : ""), u.id] },
                { selected: current_user.id },
                class: "w-full bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
          </div>
        <% end %>

        <div>
          <%= f.label :income_type, class: "block text-sm font-medium text-warm-gray mb-1" %>
          <%= f.select :income_type,
              [["Fixed (set amount)", "fixed"], ["Hourly (from salary entry)", "hourly"]],
              {},
              class: "w-full bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500",
              data: { action: "income-source#toggle" } %>
        </div>

        <div data-income-source-target="amountField">
          <%= f.label :amount, "Amount (for fixed income)", class: "block text-sm font-medium text-warm-gray mb-1" %>
          <%= f.number_field :amount, step: 0.01, min: 0,
              class: "w-full bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
        </div>

        <div>
          <%= f.label :currency, class: "block text-sm font-medium text-warm-gray mb-1" %>
          <%= f.select :currency, [["USD", "usd"], ["CRC (Colones)", "crc"]], {},
              class: "w-full bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
        </div>

        <div data-income-source-target="linkedUserField">
          <%= f.label :linked_user_id, "Link to User (for hourly)", class: "block text-sm font-medium text-warm-gray mb-1" %>
          <%= f.select :linked_user_id,
              @linkable_users.map { |u| [u.name, u.id] },
              { include_blank: "None" },
              class: "w-full bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
          <p class="text-xs text-muted-light mt-1">For hourly income, link to a user's salary entries</p>
        </div>

        <div class="flex items-end">
          <%= f.submit "Add Income Source",
              class: "bg-gold-btn text-navy-900 font-semibold px-6 py-2 rounded-lg cursor-pointer" %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @my_income_sources.any? %>
    <div class="bg-navy-800 rounded-lg border border-navy-600 overflow-hidden">
      <div class="px-6 py-3 bg-navy-900 border-b border-navy-600">
        <h3 class="text-sm font-medium text-cream">My Income Sources</h3>
      </div>
      <table class="min-w-full divide-y divide-navy-600">
        <thead class="bg-navy-900">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-warm-gray uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-warm-gray uppercase">Type</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-warm-gray uppercase">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-warm-gray uppercase">Status</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-warm-gray uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-navy-800 divide-y divide-navy-600">
          <% @my_income_sources.each do |source| %>
            <%= render partial: "income_source_row", locals: { source: source, can_edit: true } %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-12 bg-navy-800 rounded-lg border border-navy-600">
      <p class="text-muted-light">No income sources yet. Add one above to get started.</p>
    </div>
  <% end %>

  <% if @household_income_sources.any? %>
    <div class="bg-navy-800 rounded-lg border border-navy-600 overflow-hidden mt-6">
      <div class="px-6 py-3 bg-navy-900 border-b border-purple-500/30">
        <h3 class="text-sm font-medium text-purple-300">Household Income Sources</h3>
      </div>
      <table class="min-w-full divide-y divide-navy-600">
        <thead class="bg-navy-900">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-warm-gray uppercase">Name</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-warm-gray uppercase">Type</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-warm-gray uppercase">Amount</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-warm-gray uppercase">Status</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-warm-gray uppercase">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-navy-800 divide-y divide-navy-600">
          <% @household_income_sources.each do |source| %>
            <%= render partial: "income_source_row", locals: { source: source, can_edit: source.editable_by?(current_user) } %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
