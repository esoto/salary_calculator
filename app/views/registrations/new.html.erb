<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <%# Background gradient orbs %>
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -left-40 w-96 h-96 rounded-full opacity-20 blur-3xl bg-orb-gold"></div>
    <div class="absolute bottom-1/3 -right-32 w-80 h-80 rounded-full opacity-15 blur-3xl bg-orb-blue"></div>
  </div>

  <%# Subtle grid pattern %>
  <div class="absolute inset-0 opacity-[0.03] landing-grid-pattern"></div>

  <div class="relative z-10 w-full max-w-md mx-auto px-6 py-12">
    <%# Logo / Brand %>
    <div class="text-center mb-10">
      <%= link_to root_path, class: "inline-block" do %>
        <span class="text-2xl font-semibold text-white tracking-tight font-display">Salary Calculator</span>
      <% end %>
    </div>

    <%# Card %>
    <div class="rounded-2xl border border-slate-700/60 bg-navy-800/50 backdrop-blur-sm p-8 shadow-2xl">
      <h1 class="text-2xl font-bold text-white mb-2 font-display">Create your account</h1>
      <p class="text-slate-400 text-sm mb-8">Start tracking your salary in under a minute</p>

      <% if @user.errors.any? %>
        <div class="mb-6 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-3">
          <p class="text-sm font-medium text-red-300 mb-2"><%= pluralize(@user.errors.count, "error") %> prevented signup:</p>
          <ul class="list-disc list-inside text-sm text-red-400 space-y-1">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user, url: registrations_path, class: "space-y-5" do |form| %>
        <div>
          <%= form.label :name, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= form.text_field :name,
              class: "w-full rounded-lg border border-slate-600/80 bg-navy-900/80 px-4 py-2.5 text-white placeholder-slate-500 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 focus:outline-none transition-colors",
              required: true,
              autofocus: true,
              autocomplete: "name",
              placeholder: "Your full name" %>
        </div>

        <div>
          <%= form.label :email_address, "Email", class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= form.email_field :email_address,
              class: "w-full rounded-lg border border-slate-600/80 bg-navy-900/80 px-4 py-2.5 text-white placeholder-slate-500 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 focus:outline-none transition-colors",
              required: true,
              autocomplete: "email",
              placeholder: "you@example.com" %>
        </div>

        <div>
          <%= form.label :password, class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= form.password_field :password,
              class: "w-full rounded-lg border border-slate-600/80 bg-navy-900/80 px-4 py-2.5 text-white placeholder-slate-500 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 focus:outline-none transition-colors",
              required: true,
              autocomplete: "new-password",
              placeholder: "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022" %>
        </div>

        <div>
          <%= form.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <%= form.password_field :password_confirmation,
              class: "w-full rounded-lg border border-slate-600/80 bg-navy-900/80 px-4 py-2.5 text-white placeholder-slate-500 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 focus:outline-none transition-colors",
              required: true,
              autocomplete: "new-password",
              placeholder: "\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022" %>
        </div>

        <div>
          <%= form.label :default_hourly_rate, "Hourly rate", class: "block text-sm font-medium text-slate-300 mb-1.5" %>
          <div class="flex items-center gap-2">
            <%= form.number_field :default_hourly_rate,
                step: 0.01, min: 0,
                class: "w-full rounded-lg border border-slate-600/80 bg-navy-900/80 px-4 py-2.5 text-white placeholder-slate-500 focus:border-gold-500 focus:ring-1 focus:ring-gold-500 focus:outline-none transition-colors",
                placeholder: "0.00" %>
            <span class="text-xs text-slate-500 whitespace-nowrap">Optional</span>
          </div>
        </div>

        <div class="pt-1">
          <%= form.submit "Create Account",
              class: "w-full appearance-none rounded-full py-3 text-base font-semibold transition-all duration-300 cursor-pointer hover:shadow-lg hover:shadow-amber-900/20 hover:-translate-y-0.5 bg-gold-btn text-navy-900" %>
        </div>
      <% end %>
    </div>

    <%# Login link %>
    <p class="text-center text-sm text-slate-400 mt-8">
      Already have an account?
      <%= link_to "Log in", new_session_path,
          class: "text-gold-500 hover:text-gold-300 font-medium transition-colors" %>
    </p>
  </div>
</section>
