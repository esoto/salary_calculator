<div class="max-w-2xl mx-auto mt-8 px-4">
  <h1 class="text-2xl font-bold text-cream font-display mb-6">Connected Apps</h1>

  <% if @tokens.any? %>
    <div class="bg-navy-800 border border-navy-600 rounded-lg overflow-hidden">
      <table class="min-w-full">
        <thead class="bg-navy-900">
          <tr>
            <th class="px-4 py-3 text-left text-warm-gray text-sm font-medium">Name</th>
            <th class="px-4 py-3 text-left text-warm-gray text-sm font-medium">Scopes</th>
            <th class="px-4 py-3 text-left text-warm-gray text-sm font-medium">Last used</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody>
          <% @tokens.each do |token| %>
            <tr class="border-t border-navy-600">
              <td class="px-4 py-3 text-cream"><%= token.name %></td>
              <td class="px-4 py-3 text-sm text-warm-gray"><%= token.scopes.presence || "—" %></td>
              <td class="px-4 py-3 text-sm text-warm-gray">
                <%= token.last_used_at ? time_ago_in_words(token.last_used_at) + " ago" : "never" %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= button_to "Revoke", connected_app_path(token),
                      method: :delete,
                      form: { data: { turbo_confirm: "Revoke this token?" } },
                      class: "text-red-400 hover:text-red-300 text-sm font-medium" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-warm-gray">You have no connected apps.</p>
  <% end %>
</div>
