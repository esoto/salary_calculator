<%= form_with model: budget, url: budget.persisted? ? budget_path(budget) : budgets_path, class: "bg-navy-800 rounded-lg border border-navy-600 p-6" do |f| %>
  <% if budget.errors.any? %>
    <div class="bg-error-600/10 border border-error-500/30 rounded-lg p-4 mb-6">
      <h2 class="text-error-500 font-medium"><%= pluralize(budget.errors.count, "error") %> prohibited this budget from being saved:</h2>
      <ul class="list-disc list-inside mt-2 text-error-500">
        <% budget.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div>
      <%= f.label :year, class: "block text-sm font-medium text-warm-gray mb-1" %>
      <%= f.select :year, options_for_select(year_options_for_select, budget.year),
          {},
          class: "w-full bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
    </div>

    <div>
      <%= f.label :month, class: "block text-sm font-medium text-warm-gray mb-1" %>
      <%= f.select :month, options_for_select(month_options_for_select, budget.month),
          {},
          class: "w-full bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
    </div>

    <div>
      <%= f.label :exchange_rate, "Exchange Rate (₡ per $1)", class: "block text-sm font-medium text-warm-gray mb-1" %>
      <%= f.number_field :exchange_rate, step: 0.01, min: 0,
          value: f.object.exchange_rate&.to_f&.then { |v| v == v.to_i ? v.to_i : v },
          class: "w-full bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" %>
    </div>
  </div>

  <% if current_user.household.present? %>
    <div class="mt-4 pt-4 border-t border-navy-600">
      <label class="flex items-center gap-3 cursor-pointer">
        <%= f.check_box :shared_with_household, class: "w-5 h-5 text-gold-500 rounded focus:ring-gold-500" %>
        <div>
          <span class="font-medium text-cream">Share with household</span>
          <p class="text-sm text-warm-gray">Household members can view and edit this budget</p>
        </div>
      </label>
    </div>
  <% end %>

  <div class="flex justify-between items-center">
    <%= link_to "Cancel", budgets_path(year: budget.year), class: "border border-navy-600 hover:bg-navy-900 text-warm-gray px-6 py-2 rounded-lg" %>
    <%= f.submit budget.persisted? ? "Update Budget" : "Create Budget",
        class: "bg-gold-btn text-navy-900 font-semibold px-6 py-2 rounded-lg cursor-pointer" %>
  </div>
<% end %>
