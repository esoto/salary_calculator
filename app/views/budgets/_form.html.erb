<%= form_with model: budget, url: budget.persisted? ? budget_path(budget) : budgets_path, class: "bg-white rounded-lg shadow p-6" do |f| %>
  <% if budget.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <h2 class="text-red-800 font-medium"><%= pluralize(budget.errors.count, "error") %> prohibited this budget from being saved:</h2>
      <ul class="list-disc list-inside mt-2 text-red-700">
        <% budget.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4">
    <%= f.label :year, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :year, (2020..2100).to_a, {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
  </div>

  <div class="mb-4">
    <%= f.label :month, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.select :month, (1..12).map { |m| [Date::MONTHNAMES[m], m] }, {}, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
  </div>

  <div class="mb-6">
    <%= f.label :exchange_rate, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.number_field :exchange_rate, step: 0.01, class: "w-full border border-gray-300 rounded-lg px-3 py-2" %>
  </div>

  <div class="flex justify-between">
    <%= link_to "Cancel", budgets_path, class: "text-gray-600 hover:text-gray-800" %>
    <%= f.submit class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg cursor-pointer" %>
  </div>
<% end %>
