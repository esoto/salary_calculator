<%= form_with model: budget, url: budget.persisted? ? budget_path(budget) : budgets_path, class: "bg-white rounded-lg shadow p-6" do |f| %>
  <% if budget.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <h2 class="text-red-800 font-medium"><%= pluralize(budget.errors.count, "error") %> prohibited this budget from being saved:</h2>
      <ul class="list-disc list-inside mt-2 text-red-700">
        <% budget.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
    <div>
      <%= f.label :year, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :year, options_for_select(year_options_for_select, budget.year),
          {},
          class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :month, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :month, options_for_select(month_options_for_select, budget.month),
          {},
          class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :exchange_rate, "Exchange Rate (₡ per $1)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :exchange_rate, step: 0.01, min: 0,
          class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>
  </div>

  <% if current_user.household.present? %>
    <div class="mt-4 pt-4 border-t border-gray-200">
      <label class="flex items-center gap-3 cursor-pointer">
        <%= f.check_box :shared_with_household, class: "w-5 h-5 text-blue-600 rounded focus:ring-blue-500" %>
        <div>
          <span class="font-medium text-gray-700">Share with household</span>
          <p class="text-sm text-gray-500">Household members can view and edit this budget</p>
        </div>
      </label>
    </div>
  <% end %>

  <div class="flex justify-between items-center">
    <%= link_to "Cancel", budgets_path(year: budget.year), class: "text-gray-600 hover:text-gray-800" %>
    <%= f.submit budget.persisted? ? "Update Budget" : "Create Budget",
        class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-2 rounded-lg cursor-pointer" %>
  </div>
<% end %>
