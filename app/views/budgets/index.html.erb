<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-cream font-display">Budgets</h1>
      <p class="text-warm-gray">Monthly budget planning</p>
    </div>

    <div class="flex flex-col md:flex-row gap-3">
      <%= form_with url: budgets_path, method: :get, local: true,
                    data: { turbo_frame: "_top" },
                    class: "flex items-center gap-2" do |form| %>
        <label for="year" class="text-sm font-medium text-warm-gray">Year:</label>
        <%= form.select :year,
                        options_for_select(year_options_for_select, @year),
                        {},
                        id: "year",
                        class: "bg-navy-900 text-cream border border-navy-600 rounded-lg px-3 py-2 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500",
                        onchange: "this.form.requestSubmit()" %>
      <% end %>

      <%= link_to "New Budget", new_budget_path(year: @year),
          class: "bg-gold-btn text-navy-900 font-semibold px-4 py-2 rounded-lg text-center" %>
    </div>
  </div>

  <% if @my_budgets.any? || @household_budgets.any? %>
    <% if @my_budgets.any? %>
      <div class="mb-8">
        <h2 class="text-xl font-semibold text-cream font-display mb-4">My Budgets</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @my_budgets.each do |budget| %>
            <%= render "budget_card", budget: budget, show_owner: false %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @household_budgets.any? %>
      <div>
        <h2 class="text-xl font-semibold text-cream font-display mb-4">Household Budgets</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @household_budgets.each do |budget| %>
            <%= render "budget_card", budget: budget, show_owner: true %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-navy-800 rounded-lg border border-navy-600 p-8 text-center">
      <p class="text-muted-light mb-4">No budgets for <%= @year %> yet.</p>
      <%= link_to "Create your first budget", new_budget_path(year: @year, month: Date.current.month),
          class: "text-gold-500 hover:text-gold-300" %>
    </div>
  <% end %>
</div>
