<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-cream font-display">Edit Budget Settings</h1>
    <p class="text-warm-gray"><%= Date::MONTHNAMES[@budget.month] %> <%= @budget.year %></p>
  </div>
  <%= render "form", budget: @budget %>

  <div class="mt-8 pt-6 border-t border-navy-600">
    <h3 class="text-lg font-semibold text-error-500 mb-3">Danger Zone</h3>
    <%= button_to "Delete Budget", budget_path(@budget),
        method: :delete,
        data: { turbo_confirm: "Are you sure you want to delete this budget? This action cannot be undone." },
        class: "bg-error-600 hover:bg-error-500 text-cream px-4 py-2 rounded-lg" %>
  </div>
</div>
