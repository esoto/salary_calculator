<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Edit Budget Settings</h1>
    <p class="text-gray-600"><%= Date::MONTHNAMES[@budget.month] %> <%= @budget.year %></p>
  </div>
  <%= render "form", budget: @budget %>

  <div class="mt-8 pt-6 border-t border-gray-200">
    <h3 class="text-lg font-semibold text-red-600 mb-3">Danger Zone</h3>
    <%= button_to "Delete Budget", budget_path(@budget),
        method: :delete,
        data: { turbo_confirm: "Are you sure you want to delete this budget? This action cannot be undone." },
        class: "bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg" %>
  </div>
</div>
