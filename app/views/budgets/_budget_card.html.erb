<%= link_to budget_path(budget), class: "block" do %>
  <div class="bg-white rounded-lg shadow p-4 hover:shadow-md transition-shadow">
    <div class="flex justify-between items-start mb-3">
      <div>
        <% if show_owner %>
          <p class="text-sm text-gray-500"><%= budget.user.name %>'s Budget</p>
        <% end %>
        <h3 class="text-lg font-semibold text-gray-900">
          <%= Date::MONTHNAMES[budget.month] %> <%= budget.year %>
        </h3>
      </div>
      <span class="text-sm text-gray-500">₡<%= number_with_delimiter(budget.exchange_rate.to_i) %>/$1</span>
    </div>

    <div class="grid grid-cols-2 gap-2 text-sm">
      <div>
        <span class="text-gray-500">Income:</span>
        <span class="font-medium"><%= format_usd(budget.total_income_usd) %></span>
      </div>
      <div>
        <span class="text-gray-500">Expenses:</span>
        <span class="font-medium"><%= format_usd(budget.total_expenses_usd) %></span>
      </div>
    </div>

    <div class="mt-3 flex gap-1">
      <% MonthlyBudget::CATEGORY_TARGETS.each_key do |category| %>
        <% status = budget.category_status(category) %>
        <span class="flex-1 h-2 rounded <%= category_status_bg(status) %>"></span>
      <% end %>
    </div>
  </div>
<% end %>
