<%= link_to budget_path(budget), class: "block" do %>
  <div class="bg-navy-800 rounded-lg border border-navy-600 p-4 hover:border-gold-500/30 transition-colors">
    <div class="flex justify-between items-start mb-3">
      <div>
        <% if show_owner %>
          <p class="text-sm text-warm-gray"><%= budget.user.name %>'s Budget</p>
        <% end %>
        <div class="flex items-center gap-2">
          <h3 class="text-lg font-semibold text-cream">
            <%= Date::MONTHNAMES[budget.month] %> <%= budget.year %>
          </h3>
          <% if budget.shared_with_household? %>
            <%= budget_shared_badge %>
          <% end %>
        </div>
      </div>
      <span class="text-sm text-warm-gray">₡<%= number_with_delimiter(budget.exchange_rate.to_i) %>/$1</span>
    </div>

    <div class="grid grid-cols-2 gap-2 text-sm">
      <div>
        <span class="text-warm-gray">Income:</span>
        <span class="font-medium text-cream"><%= format_usd(budget.total_income_usd) %></span>
      </div>
      <div>
        <span class="text-warm-gray">Expenses:</span>
        <span class="font-medium text-cream"><%= format_usd(budget.total_expenses_usd) %></span>
      </div>
    </div>

    <div class="mt-3 flex gap-1">
      <% MonthlyBudget::CATEGORY_TARGETS.each_key do |category| %>
        <% status = budget.category_status(category) %>
        <span class="flex-1 h-2 rounded <%= category_status_bg(status) %>"></span>
      <% end %>
    </div>
  </div>
<% end %>
