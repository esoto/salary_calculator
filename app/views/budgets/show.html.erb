<div class="max-w-7xl mx-auto px-4 py-8">
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-6">
    <div>
      <% if @budget.shared_with_household? && !@budget.owned_by?(current_user) %>
        <%= budget_shared_badge %>
      <% end %>
      <% if owner_label = budget_owner_label(@budget) %>
        <p class="text-sm text-gray-500"><%= owner_label %></p>
      <% end %>
      <h1 class="text-3xl font-bold text-gray-900">
        <%= Date::MONTHNAMES[@budget.month] %> <%= @budget.year %>
      </h1>
    </div>
    <div class="flex gap-3">
      <%= link_to "Edit Settings", edit_budget_path(@budget),
          class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded-lg" %>
      <% if @budget.owned_by?(current_user) %>
        <button type="button"
                onclick="document.getElementById('share-modal').showModal()"
                class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
          Share
        </button>
      <% end %>
      <%= link_to "Back to Budgets", budgets_path(year: @budget.year),
          class: "text-gray-600 hover:text-gray-800" %>
    </div>
  </div>

  <!-- Summary Bar -->
  <div class="bg-white rounded-lg shadow p-4 mb-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <span class="text-gray-500">Exchange Rate:</span>
        <span class="font-medium">₡<%= number_with_delimiter(@budget.exchange_rate.to_i) %>/$1</span>
      </div>
      <div>
        <span class="text-gray-500">Total Income:</span>
        <span class="font-medium text-green-600"><%= format_usd(@budget.total_income_usd) %></span>
      </div>
      <div>
        <span class="text-gray-500">Total Expenses:</span>
        <span class="font-medium"><%= format_usd(@budget.total_expenses_usd) %></span>
      </div>
      <div>
        <span class="text-gray-500">Remaining:</span>
        <% remaining = @budget.total_income_usd - @budget.total_expenses_usd %>
        <span class="font-medium <%= remaining >= 0 ? 'text-green-600' : 'text-red-600' %>">
          <%= format_usd(remaining) %>
        </span>
      </div>
    </div>
  </div>

  <!-- Category Columns -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <% MonthlyBudget::CATEGORY_TARGETS.each_key do |category| %>
      <%= render "category_column", budget: @budget, category: category %>
    <% end %>
  </div>

  <!-- Income Sources Section -->
  <% if @income_sources.any? %>
    <div class="bg-white rounded-lg shadow p-4">
      <h3 class="text-lg font-semibold text-gray-800 mb-3">Income Sources</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @income_sources.each do |source| %>
          <div class="border <%= source.owned_by?(@budget.user) ? 'border-gray-200' : 'border-purple-200 bg-purple-50' %> rounded-lg p-3">
            <div class="flex justify-between items-center">
              <span class="font-medium"><%= source.name %></span>
              <span class="text-green-600 font-medium">
                <% if source.usd? %>
                  <%= format_usd(source.amount_for_month(@budget.year, @budget.month)) %>
                <% else %>
                  <%= format_crc(source.amount_for_month(@budget.year, @budget.month)) %>
                <% end %>
              </span>
            </div>
            <% if source.linked_user %>
              <p class="text-sm text-gray-500">From <%= source.linked_user.name %>'s salary</p>
            <% elsif !source.owned_by?(@budget.user) %>
              <p class="text-sm text-purple-600"><%= source.user.name %>'s income</p>
            <% else %>
              <p class="text-sm text-gray-500">Fixed income</p>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="mt-3 pt-3 border-t border-gray-200">
        <%= link_to "Manage Income Sources", income_sources_path, class: "text-blue-600 hover:text-blue-800 text-sm" %>
      </div>
    </div>
  <% else %>
    <div class="bg-white rounded-lg shadow p-4 text-center">
      <p class="text-gray-500 mb-2">No income sources configured.</p>
      <%= link_to "Add Income Sources", income_sources_path, class: "text-blue-600 hover:text-blue-800" %>
    </div>
  <% end %>

  <!-- Personal Savings Section -->
  <% if @salary_entry && @budget.user.any_savings_enabled? %>
    <div class="bg-white rounded-lg shadow p-4 mt-6">
      <h3 class="text-lg font-semibold text-gray-800 mb-3">Personal Savings</h3>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        <% if @budget.user.aguinaldo_enabled %>
          <div>
            <span class="text-gray-500">Aguinaldo:</span>
            <span class="font-medium text-blue-600"><%= format_usd(@salary_entry.aguinaldo_savings) %></span>
          </div>
        <% end %>
        <% if @budget.user.vacation_enabled %>
          <div>
            <span class="text-gray-500">Vacation:</span>
            <span class="font-medium text-blue-600"><%= format_usd(@salary_entry.vacation_savings) %></span>
          </div>
        <% end %>
        <% if @budget.user.holiday_enabled %>
          <div>
            <span class="text-gray-500">Holiday:</span>
            <span class="font-medium text-blue-600"><%= format_usd(@salary_entry.holiday_savings) %></span>
          </div>
        <% end %>
        <div class="border-l border-gray-300 pl-6">
          <span class="text-gray-500">Total:</span>
          <span class="font-semibold text-blue-700"><%= format_usd(@salary_entry.monthly_savings_accrual) %></span>
        </div>
      </div>
      <p class="text-xs text-gray-400 mt-2">Based on salary entry for this month</p>
    </div>
  <% end %>

  <!-- Activity Log Section -->
  <% activity = @budget.recent_activity(limit: 10) %>
  <% if activity.any? %>
    <details class="bg-white rounded-lg shadow mt-6">
      <summary class="cursor-pointer px-4 py-3 text-lg font-semibold text-gray-800 hover:bg-gray-50 rounded-t-lg">
        Recent Activity
      </summary>
      <div class="px-4 pb-4">
        <ul class="divide-y divide-gray-100">
          <% activity.each do |version| %>
            <li class="py-2 text-sm">
              <span class="font-medium"><%= activity_actor_name(version, current_user) %></span>
              <span class="text-gray-600"><%= activity_description(version) %></span>
              <span class="text-gray-400 text-xs ml-2"><%= activity_time_ago(version) %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </details>
  <% end %>

  <% if @budget.owned_by?(current_user) %>
    <!-- Share Modal -->
    <dialog id="share-modal" class="rounded-lg shadow-xl p-0 backdrop:bg-black/50">
      <div class="p-6 w-96">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold">Share Budget</h2>
          <button onclick="document.getElementById('share-modal').close()" class="text-gray-400 hover:text-gray-600">✕</button>
        </div>
        <%= render "budget_shares/form", budget: @budget, share: @new_share %>
      </div>
    </dialog>

    <!-- Existing Shares -->
    <% if @shares&.any? %>
      <div class="bg-white rounded-lg shadow mt-6 p-4" id="shares-list">
        <h3 class="text-lg font-semibold text-gray-800 mb-3">Shared Links</h3>
        <div class="divide-y divide-gray-100">
          <% @shares.each do |share| %>
            <%= render "budget_shares/share", share: share %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
