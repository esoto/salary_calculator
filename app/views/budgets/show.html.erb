<div class="max-w-7xl mx-auto px-4 py-8"
     data-budget-context='<%= { id: @budget.id, year: @budget.year, month: @budget.month }.to_json %>'>
  <!-- Header -->
  <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-6">
    <div>
      <% if @budget.shared_with_household? && !@budget.owned_by?(current_user) %>
        <%= budget_shared_badge %>
      <% end %>
      <% if owner_label = budget_owner_label(@budget) %>
        <p class="text-sm text-muted-light"><%= owner_label %></p>
      <% end %>
      <h1 class="text-3xl font-bold text-cream font-display">
        <%= Date::MONTHNAMES[@budget.month] %> <%= @budget.year %>
      </h1>
    </div>
    <div class="flex gap-3">
      <%= link_to "Edit Settings", edit_budget_path(@budget),
          class: "bg-navy-600 hover:bg-navy-800 text-cream px-4 py-2 rounded-lg" %>
      <% if @budget.owned_by?(current_user) %>
        <button type="button"
                onclick="document.getElementById('share-modal').showModal()"
                class="bg-gold-btn text-navy-900 font-semibold px-4 py-2 rounded-lg">
          Share
        </button>
      <% end %>
      <%= link_to "← Back to Budgets", budgets_path(year: @budget.year),
          class: "text-gold-500 hover:text-gold-300" %>
    </div>
  </div>

  <!-- Summary Bar -->
  <%= render "summary_bar", budget: @budget %>

  <!-- Category Columns -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <% MonthlyBudget::CATEGORY_TARGETS.each_key do |category| %>
      <%= render "category_column", budget: @budget, category: category %>
    <% end %>
  </div>

  <!-- Income Sources Section -->
  <% if @income_sources.any? %>
    <div class="bg-navy-800 rounded-lg border border-navy-600 p-4">
      <h3 class="text-lg font-semibold text-cream font-display mb-3">Income Sources</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @income_sources.each do |source| %>
          <%= render "income_source_card", source: source, budget: @budget %>
        <% end %>
      </div>
      <div class="mt-3 pt-3 border-t border-navy-600">
        <%= link_to "Manage Income Sources", income_sources_path, class: "text-gold-500 hover:text-gold-300 text-sm" %>
      </div>
    </div>
  <% else %>
    <div class="bg-navy-800 rounded-lg border border-navy-600 p-6 text-center">
      <div class="text-2xl mb-2">💰</div>
      <p class="text-muted-light mb-3">Add income sources to track your budget against actual earnings.</p>
      <%= link_to income_sources_path, class: "inline-block text-gold-500 hover:text-gold-300 font-medium" do %>
        Configure income sources &rarr;
      <% end %>
    </div>
  <% end %>

  <!-- Personal Savings Section -->
  <% if @salary_entry && @budget.user.any_savings_enabled? %>
    <div class="bg-navy-800 rounded-lg border border-navy-600 p-4 mt-6">
      <h3 class="text-lg font-semibold text-cream font-display mb-3">Personal Savings</h3>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
        <% if @budget.user.aguinaldo_enabled %>
          <div>
            <span class="text-warm-gray">Aguinaldo:</span>
            <span class="font-medium text-gold-500"><%= format_usd(@salary_entry.aguinaldo_savings) %></span>
          </div>
        <% end %>
        <% if @budget.user.vacation_enabled %>
          <div>
            <span class="text-warm-gray">Vacation:</span>
            <span class="font-medium text-gold-500"><%= format_usd(@salary_entry.vacation_savings) %></span>
          </div>
        <% end %>
        <% if @budget.user.holiday_enabled %>
          <div>
            <span class="text-warm-gray">Holiday:</span>
            <span class="font-medium text-gold-500"><%= format_usd(@salary_entry.holiday_savings) %></span>
          </div>
        <% end %>
        <div class="border-l border-navy-600 pl-6">
          <span class="text-warm-gray">Total:</span>
          <span class="font-semibold text-gold-400"><%= format_usd(@salary_entry.monthly_savings_accrual) %></span>
        </div>
      </div>
      <p class="text-xs text-muted-light mt-2">Based on salary entry for this month</p>
    </div>
  <% end %>

  <!-- Activity Log Section -->
  <% activity = @budget.recent_activity(limit: 10) %>
  <% if activity.any? %>
    <details class="bg-navy-800 rounded-lg border border-navy-600 mt-6">
      <summary class="cursor-pointer px-4 py-3 text-lg font-semibold text-cream hover:bg-navy-900/50 rounded-t-lg font-display">
        Recent Activity
      </summary>
      <div class="px-4 pb-4">
        <ul class="divide-y divide-navy-600">
          <% activity.each do |version| %>
            <li class="py-2 text-sm">
              <span class="font-medium text-cream"><%= activity_actor_name(version, current_user) %></span>
              <span class="text-warm-gray"><%= activity_description(version) %></span>
              <span class="text-muted-light text-xs ml-2"><%= activity_time_ago(version) %></span>
            </li>
          <% end %>
        </ul>
      </div>
    </details>
  <% end %>

  <% if @budget.owned_by?(current_user) %>
    <!-- Share Modal -->
    <dialog id="share-modal" class="rounded-lg shadow-xl p-0"
            data-controller="dialog"
            data-action="close->dialog#resetForm">
      <div class="p-6 w-96 bg-navy-800">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-xl font-bold text-cream">Share Budget</h2>
          <button data-action="click->dialog#close" type="button" class="text-muted-light hover:text-warm-gray">✕</button>
        </div>
        <div id="share-form-container" data-dialog-target="formContainer">
          <%= render "budget_shares/form", budget: @budget, share: @new_share %>
        </div>
      </div>
      <template data-dialog-target="formTemplate">
        <%= render "budget_shares/form", budget: @budget, share: @new_share %>
      </template>
    </dialog>

    <!-- Existing Shares -->
    <div class="<%= 'bg-navy-800 rounded-lg border border-navy-600 mt-6 p-6' if @shares&.any? %>" id="shares-list">
      <% if @shares&.any? %>
        <h3 class="text-lg font-semibold text-cream font-display mb-4">Shared Links</h3>
      <% end %>
      <div class="space-y-3" id="shares-items">
        <% @shares&.each do |share| %>
          <%= render "budget_shares/share", share: share %>
        <% end %>
      </div>
    </div>
  <% end %>

  <% if @income_sources.any?(&:fixed?) && @income_sources.any? { |s| s.editable_by?(current_user) } %>
    <dialog id="override-modal"
            class="rounded-lg shadow-xl p-0"
            aria-labelledby="override-modal-title"
            data-controller="dialog override-modal">
      <div class="p-6 w-96 bg-navy-800">
        <div class="flex justify-between items-center mb-4">
          <h2 id="override-modal-title" class="text-xl font-bold text-cream" data-override-modal-target="title">
            Adjust Income
          </h2>
          <button type="button" data-action="click->dialog#close" class="text-muted-light hover:text-warm-gray">✕</button>
        </div>

        <div data-override-modal-target="currentAmount" class="text-sm text-warm-gray mb-4"></div>

        <%= form_with url: "#", method: :post, local: false,
                      data: { override_modal_target: "form" } do |f| %>
          <input type="hidden" name="income_source_override[income_source_id]" data-override-modal-target="sourceIdInput" />

          <div class="mb-4">
            <label for="override-amount" class="block text-sm text-warm-gray mb-1">Amount</label>
            <%= f.number_field :amount, step: 0.01, id: "override-amount",
                               data: { override_modal_target: "amountInput" },
                               class: "w-full rounded bg-navy-900 text-cream p-2",
                               name: "income_source_override[amount]" %>
          </div>

          <fieldset class="mb-4">
            <legend class="text-sm text-warm-gray mb-2">Apply this change to</legend>
            <label class="block text-cream">
              <input type="radio" name="income_source_override[scope]" value="single_month" checked
                     data-override-modal-target="scopeSingle" />
              <span data-override-modal-target="scopeSingleLabel">Just this month</span>
            </label>
            <label class="block text-cream">
              <input type="radio" name="income_source_override[scope]" value="from_this_month"
                     data-override-modal-target="scopeOngoing" />
              <span data-override-modal-target="scopeOngoingLabel">Starting this month onward</span>
            </label>
          </fieldset>

          <div class="flex gap-2">
            <button type="submit" class="bg-gold-btn text-navy-900 font-semibold px-4 py-2 rounded-lg">Save</button>
            <button type="button" data-action="click->dialog#close" class="text-muted-light px-4 py-2">Cancel</button>
          </div>
        <% end %>

        <div class="mt-4 pt-4 border-t border-navy-600 space-y-2" data-override-modal-target="removeLinks">
          <!-- populated by JS when overrides exist -->
        </div>
      </div>
    </dialog>
  <% end %>
</div>
