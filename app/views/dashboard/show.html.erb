<%# app/views/dashboard/show.html.erb %>
<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex flex-col md:flex-row md:justify-between md:items-center gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-cream font-display">Dashboard</h1>
      <p class="text-warm-gray">Welcome back, <%= current_user.name %></p>
    </div>

    <div class="flex flex-col md:flex-row gap-3">
      <% if @available_years.any? %>
        <%= form_with url: dashboard_path, method: :get, local: true,
                      data: { turbo_frame: "_top" },
                      class: "flex items-center gap-2" do |form| %>
          <label for="year" class="text-sm font-medium text-warm-gray">Year:</label>
          <%= form.select :year,
                          options_for_select(@available_years, @selected_year),
                          {},
                          id: "year",
                          class: "border border-navy-600 bg-navy-900 text-cream rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gold-500",
                          onchange: "this.form.requestSubmit()" %>
        <% end %>
      <% end %>

      <%= link_to "New Entry", new_salary_entry_path,
          class: "bg-gold-btn text-navy-900 px-4 py-2 rounded-lg text-center font-semibold hover:shadow-lg hover:shadow-amber-900/20" %>
    </div>
  </div>

  <!-- Summary Cards Row -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 mb-6">
    <% if @user.aguinaldo_enabled %>
      <!-- Aguinaldo Card -->
      <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
        <h3 class="text-sm font-medium text-muted-light uppercase">Aguinaldo <%= @current_year %></h3>
        <p class="text-2xl font-bold text-cream mt-2"><%= format_currency(@aguinaldo_savings) %></p>
        <p class="text-sm text-muted-light mt-1">Dec '<%= (@current_year - 1) % 100 %> - Nov '<%= @current_year % 100 %></p>
      </div>
    <% end %>

    <!-- Total Earnings Card -->
    <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
      <h3 class="text-sm font-medium text-muted-light uppercase">Total Earnings</h3>
      <p class="text-2xl font-bold text-cream mt-2"><%= format_currency(@total_earnings) %></p>
      <p class="text-sm text-muted-light mt-1">YTD <%= @current_year %></p>
    </div>

    <!-- Net Pay Card -->
    <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
      <h3 class="text-sm font-medium text-muted-light uppercase">Net Pay</h3>
      <p class="text-2xl font-bold text-gold-500 mt-2"><%= format_currency(@net_pay) %></p>
      <p class="text-sm text-muted-light mt-1">YTD <%= @current_year %></p>
    </div>

    <!-- Months Logged Card -->
    <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
      <h3 class="text-sm font-medium text-muted-light uppercase">Months Logged</h3>
      <p class="text-2xl font-bold text-cream mt-2"><%= @months_logged %> of 12</p>
      <p class="text-sm text-muted-light mt-1"><%= @current_year %></p>
    </div>

    <% if @user.any_savings_enabled? %>
      <!-- Total Savings Card -->
      <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
        <h3 class="text-sm font-medium text-muted-light uppercase">Total Savings</h3>
        <p class="text-2xl font-bold text-success-500 mt-2"><%= format_currency(@total_savings) %></p>
        <p class="text-sm text-muted-light mt-1">Dec '<%= (@current_year - 1) % 100 %> - Nov '<%= @current_year % 100 %></p>
      </div>
    <% end %>
  </div>

  <!-- Savings & Days Cards Row -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
    <% if @user.vacation_enabled %>
      <!-- Vacation Savings -->
      <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
        <h3 class="text-sm font-medium text-muted-light uppercase">Vacation $</h3>
        <p class="text-xl font-bold text-success-500 mt-2"><%= format_currency(@vacation_balance) %></p>
        <p class="text-sm text-muted-light mt-1">balance</p>
      </div>

      <!-- Vacation Days -->
      <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
        <h3 class="text-sm font-medium text-muted-light uppercase">Vacation Days</h3>
        <p class="text-xl font-bold text-success-500 mt-2"><%= number_with_precision(@vacation_days_available, precision: 1) %> available</p>
        <p class="text-sm text-muted-light mt-1"><%= number_with_precision(@vacation_days_earned, precision: 1) %> earned</p>
      </div>
    <% end %>

    <% if @user.holiday_enabled %>
      <!-- Holiday Savings -->
      <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
        <h3 class="text-sm font-medium text-muted-light uppercase">Holiday $</h3>
        <p class="text-xl font-bold text-success-500 mt-2"><%= format_currency(@holiday_balance) %></p>
        <p class="text-sm text-muted-light mt-1">balance</p>
      </div>

      <!-- Holiday Days -->
      <div class="bg-navy-800 rounded-lg border border-navy-600 p-6">
        <h3 class="text-sm font-medium text-muted-light uppercase">Holiday Days</h3>
        <p class="text-xl font-bold text-success-500 mt-2"><%= number_with_precision(@holiday_days_available, precision: 1) %> available</p>
        <p class="text-sm text-muted-light mt-1"><%= number_with_precision(@holiday_days_earned, precision: 1) %> earned</p>
      </div>
    <% end %>
  </div>

  <!-- Savings Breakdown Chart -->
  <% if @ytd_entries.any? && (@user.aguinaldo_enabled || @user.vacation_enabled || @user.holiday_enabled) %>
    <div class="bg-navy-800 rounded-lg border border-navy-600 p-6 mb-8">
      <h2 class="text-lg font-semibold text-cream mb-4 font-display">
        Savings Breakdown <%= @selected_year %>
      </h2>

      <%= column_chart @savings_chart_data,
                       stacked: true,
                       colors: ["#3B82F6", "#10B981", "#F59E0B"],
                       prefix: "$",
                       thousands: ",",
                       library: {
                         plugins: {
                           legend: { position: 'top', labels: { color: '#e2e0db' } }
                         },
                         scales: {
                           x: { ticks: { color: '#718096' }, grid: { color: '#1a1f3a' } },
                           y: { ticks: { color: '#718096' }, grid: { color: '#1a1f3a' } }
                         }
                       } %>
    </div>
  <% end %>

  <!-- Recent Entries -->
  <div class="bg-navy-800 rounded-lg border border-navy-600">
    <div class="px-6 py-4 border-b border-navy-600">
      <h2 class="text-lg font-semibold text-cream font-display">Recent Entries</h2>
    </div>

    <% if @recent_entries.any? %>
      <table class="min-w-full divide-y divide-navy-600">
        <thead class="bg-navy-900">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-muted-light uppercase">Month</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Hours</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Rate</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Salary</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-muted-light uppercase">Net Pay</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-navy-600">
          <% @recent_entries.each do |entry| %>
            <tr class="hover:bg-navy-900/50">
              <td class="px-6 py-4">
                <%= link_to "#{month_name(entry.month)} #{entry.year}", entry,
                    class: "text-gold-500 hover:text-gold-300" %>
              </td>
              <td class="px-6 py-4 text-right text-warm-gray"><%= format_hours(entry.hours_worked) %></td>
              <td class="px-6 py-4 text-right text-warm-gray"><%= format_currency(entry.hourly_rate) %></td>
              <td class="px-6 py-4 text-right font-medium text-cream"><%= format_currency(entry.monthly_salary) %></td>
              <td class="px-6 py-4 text-right font-bold text-gold-500"><%= format_currency(entry.net_pay) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="px-6 py-12 text-center">
        <div class="text-3xl mb-3">📊</div>
        <p class="text-muted-light mb-4">Track your first month of earnings to see your dashboard come alive.</p>
        <%= link_to new_salary_entry_path, class: "inline-block bg-gold-btn text-navy-900 font-semibold px-5 py-2 rounded-lg hover:shadow-lg hover:shadow-amber-900/20" do %>
          Create first entry &rarr;
        <% end %>
      </div>
    <% end %>

    <% if @recent_entries.any? %>
      <div class="px-6 py-4 border-t border-navy-600">
        <%= link_to "View all entries", salary_entries_path, class: "text-gold-500 hover:text-gold-300" %>
      </div>
    <% end %>
  </div>
</div>
